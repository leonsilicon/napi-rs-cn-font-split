{
  "name": "napi-rs-cn-font-split",
  "version": "1.0.1",
  "description": "napi-rs binding for cn-font-split: subset/split CJK fonts into unicode-range woff2 chunks",
  "main": "dist/index.cjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonsilicon/napi-rs-cn-font-split.git"
  },
  "homepage": "https://github.com/leonsilicon/napi-rs-cn-font-split#readme",
  "license": "MIT",
  "keywords": [
    "napi-rs",
    "NAPI",
    "N-API",
    "Rust",
    "node-addon",
    "font",
    "font-subset",
    "woff2",
    "cjk",
    "cn-font-split"
  ],
  "files": [
    "dist/index.cjs",
    "dist/index.d.cts",
    "dist/napi.cjs",
    "dist/napi.d.ts"
  ],
  "napi": {
    "binaryName": "napi-rs-cn-font-split",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 18.17.0 < 19 || >= 20.3.0 < 21 || >= 21.1.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "build": "yarn build:napi && yarn bundle",
    "build:debug": "yarn build:napi:debug && yarn bundle",
    "format": "run-p format:prettier format:rs format:toml",
    "format:prettier": "prettier . -w",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "lint": "oxlint .",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "ava",
    "preversion": "yarn build && git add .",
    "version": "napi version",
    "prepare": "husky",
    "build:napi": "napi build --platform --release -o dist --js napi.cjs --dts napi.d.ts",
    "build:napi:debug": "napi build --platform -o dist --js napi.cjs --dts napi.d.ts",
    "bundle": "tsdown"
  },
  "devDependencies": {
    "@emnapi/core": "^1.5.0",
    "@emnapi/runtime": "^1.5.0",
    "@napi-rs/cli": "^3.2.0",
    "@oxc-node/core": "^0.1.0",
    "@taplo/cli": "^0.7.0",
    "@tybys/wasm-util": "^0.10.0",
    "ava": "^8.0.0",
    "chalk": "^5.6.2",
    "cn-font-split": "^7.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.14.0",
    "prettier": "^3.6.2",
    "tinybench": "^6.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.0"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json)": [
      "prettier --write"
    ],
    "*.toml": [
      "taplo format"
    ]
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "timeout": "2m",
    "workerThreads": false,
    "environmentVariables": {
      "OXC_TSCONFIG_PATH": "./__test__/tsconfig.json"
    },
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  },
  "packageManager": "yarn@4.14.1",
  "dependenciesMeta": {
    "cn-font-split": {
      "built": false
    }
  },
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  }
}
